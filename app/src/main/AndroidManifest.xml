<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.alarma">

    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/apps"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/apps"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alarma">

        <activity android:name=".WebActivity" android:exported="false" />
        <activity android:name=".AlarmaActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>