<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:orientation="vertical"
    android:background="#EB968D">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Navegador"
        android:textStyle="bold"
        android:textSize="50dp"
        android:textAlignment="center"/>

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce una URL"
        android:inputType="textUri"
        android:layout_marginTop="100dp"/>

    <Button
        android:id="@+id/btnAbrirWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Abrir en navegador"
        android:backgroundTint="#7C2E18"/>

    <ImageButton
        android:id="@+id/returnButton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@android:drawable/ic_menu_revert"
        android:layout_gravity="center"
        android:backgroundTint="#EB968D"
        android:layout_marginTop="300dp"/>

</LinearLayout>
